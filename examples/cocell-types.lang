def mapCaptured : (A : Type 0) -> (F : A -> Type 0) -> (a : A) -> F a -> StreamK Nat -> F a :=
  fun A F a x w => extract (map (fun (n : Nat) => x) w)
def mapCapturedHint : (A : Type 0) -> (F : A -> Type 0) -> (a : A) -> F a -> StreamK Nat -> StreamK (F a) :=
