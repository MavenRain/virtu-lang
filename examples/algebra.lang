-- Formers F6 and F7: fold over Nat and List, finCase over Fin 3; take of a Stream made by unfold.
def sumList : (xs : List Nat) -> Nat :=
  fun (xs : List Nat) => fold (fun (x : Nat) (acc : Nat) => natAdd x acc) 0 xs
def square : (n : Nat) -> Nat := fun (n : Nat) => fold (fun (acc : Nat) => natAdd acc n) 0 n
def ones : (n : Nat) -> List Nat := fun (n : Nat) => fold (fun (acc : List Nat) => cons 1 acc) nil n
def colorCode : (c : Fin 3) -> Nat := fun (c : Fin 3) => finCase 3 c 1 2 3
def take : (A : Type 0) -> (k : Nat) -> (s : Stream A) -> List A :=
  fun (A : Type 0) (k : Nat) => fold (fun (acc : Stream A -> List A) (s : Stream A) => cons (shead (out s)) (acc (stail (out s)))) (fun (s : Stream A) => nil) k
def down : List Nat := take Nat 3 (unfold (fun (n : Nat) => scons Nat Nat n (natSub n 1)) 5)
def stop : List Nat := take Nat 0 (unfold (fun (n : Nat) => scons Nat Nat n (succ n)) 5)
