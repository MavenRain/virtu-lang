-- Two different steps give the same stream of zeros, but S4 gives no path
-- from a bisimulation (Q5). The bisimulation rule (S4 K5 (a)) checks the
-- two steps at one fresh seed n: the heads agree (0), but the child seeds
-- are n and `succ n`, and the hypothesis needs the same relation for the
-- children. Here the seeds are 0, not a variable, thus the rule does not
-- apply. The two unfolds do not convert, thus refl does not have these ends.
def zerosA : Stream Nat := unfold (fun (n : Nat) => scons Nat Nat 0 n) 0
def zerosB : Stream Nat := unfold (fun (n : Nat) => scons Nat Nat 0 (succ n)) 0
def same : Path (Stream Nat) zerosA zerosB := refl
