-- Sample domain. Replace it with your design. See domain/README.md.
-- Each family, constructor, field and def name here becomes a core name
-- (rule R4). Only this file can declare a family (rule R1).
-- Bool is Fin 2 (PLAN section 5, Q1 (a)): false is 0 and true is 1.
-- boolIf is a finCase, so natEq, natLe and the filter tests give a Bool.
def Bool : Type 0 := Fin 2
def true : Bool := 1
def false : Bool := 0
def boolIf : (A : Type 0) -> Bool -> A -> A -> A :=
  fun (A : Type 0) (b : Bool) (yes : A) (no : A) => finCase 2 b no yes


-- Store (S4 K4): the cofamily of the layer StoreF at its last parameter X.
-- `out` gives one layer; `unfold g s` makes a value from the step g and
-- the seed s. The world comonad of PLAN 2.5 is Store W.
family StoreF (S : Type 0) (A : Type 0) (X : Type 0) := storeL (storePos : S) (storePeek : S -> A)
cofamily Store (S : Type 0) (A : Type 0) := StoreF S A

-- Equivalences (S3a, R3 (a)): contractible types, fibers, isEquiv and
-- Equiv as Sigma types (the map, then for each y the center pack x p and
-- the contraction), idEquiv, and isoToEquiv as in agda/cubical
-- isoToIsEquiv. isoCap is the fill at k = i1; isoPath is the first part
-- of the fiber path. The squares are inline, with j flipped.
def isContr : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => Sigma (c : A) ((x : A) -> Path A c x)
-- Propositions and sets (S4b): the squash1 fold case has the type
-- isProp RES, the squash0 and quotSquash fold cases the type isSet RES.
def isProp : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> Path A x y
def isSet : (A : Type 0) -> Type 0 :=
  fun (A : Type 0) => (x : A) -> (y : A) -> isProp (Path A x y)
def fiber : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (y : B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (y : B) => Sigma (x : A) (Path B (f x) y)
def isEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => (y : B) -> isContr (fiber A B f y)
def Equiv : (A : Type 0) -> (B : Type 0) -> Type 0 :=
  fun (A : Type 0) => fun (B : Type 0) => Sigma (f : A -> B) (isEquiv A B f)
def idEquiv : (A : Type 0) -> Equiv A A :=
  fun (A : Type 0) => pack (fun (x : A) => x) (fun (y : A) =>
    pack (pack y refl) (fun (z : fiber A A (fun (x : A) => x) y) =>
      fun (i : I) => pack (payload z @ ~i) (fun (j : I) => payload z @ (~i \/ j))))
def isoCap : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> Path A (g y) x0 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m : I) => [ i -> t x0 @ (i1 /\ m), ~i -> g y, ~i1 -> g (p0 @ ~i) ]) (g (p0 @ ~i))
def isoPath : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) -> (t : (x : A) -> Path A (g (f x)) x) ->
  (y : B) -> (x0 : A) -> (p0 : Path B (f x0) y) -> (x1 : A) -> (p1 : Path B (f x1) y) -> Path A x0 x1 :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  fun (y : B) => fun (x0 : A) => fun (p0 : Path B (f x0) y) => fun (x1 : A) => fun (p1 : Path B (f x1) y) =>
    fun (i : I) => hcomp A (i \/ ~i \/ ~i1) (fun (m2 : I) => [ i -> isoCap A B f g t y x1 p1 @ (i1 /\ m2), ~i -> isoCap A B f g t y x0 p0 @ (i1 /\ m2), ~i1 -> g y ]) (g y)
def isoToEquiv : (A : Type 0) -> (B : Type 0) -> (f : A -> B) -> (g : B -> A) ->
  (s : (y : B) -> Path B (f (g y)) y) -> (t : (x : A) -> Path A (g (f x)) x) -> Equiv A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (f : A -> B) => fun (g : B -> A) =>
  fun (s : (y : B) -> Path B (f (g y)) y) => fun (t : (x : A) -> Path A (g (f x)) x) =>
  pack f (fun (y : B) => pack (pack (g y) (s y)) (fun (z : fiber A B f y) =>
    fun (i : I) => pack (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) (fun (j : I) =>
      hcomp B (i \/ ~i \/ ~j \/ j) (fun (m4 : I) => [
        i -> s (payload z @ j) @ m4,
        ~i -> s (s y @ j) @ m4,
        ~j -> s (f (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i)) @ m4,
        j -> s y @ m4 ])
      (f (hcomp A (i \/ ~i \/ ~j \/ j) (fun (m3 : I) => [
        i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (witness z) @ (~m3 /\ m), j -> g y, m3 -> g (payload z @ j) ]) (g (payload z @ j)),
        ~i -> hcomp A (~j \/ j \/ m3) (fun (m : I) => [ ~j -> t (g y) @ (~m3 /\ m), j -> g y, m3 -> g (s y @ j) ]) (g (s y @ j)),
        ~j -> t (isoPath A B f g t y (g y) (s y) (witness z) (payload z) @ i) @ ~m3,
        j -> g y ])
        (hcomp A (i \/ ~i \/ j) (fun (m2 : I) => [
          i -> isoCap A B f g t y (witness z) (payload z) @ (~j /\ m2),
          ~i -> isoCap A B f g t y (g y) (s y) @ (~j /\ m2),
          j -> g y ]) (g y)))))))

-- ua (S3b): the Glue line from A to B. At i0 the type is A through e; at
-- i1 the type is B through idEquiv B. Transport along ua e at a closed
-- value of A gives witness e of the value (uaBeta).
def ua : (A : Type 0) -> (B : Type 0) -> (e : Equiv A B) -> Path (Type 0) A B :=
  fun (A : Type 0) => fun (B : Type 0) => fun (e : Equiv A B) =>
    fun (i : I) => Glue B (~i \/ i) (fun (_ : I) => [ ~i -> pack A e, i -> pack B (idEquiv B) ])


-- Decidability: Empty and absurd are builtins. Not A is a map into Empty.
-- Dec A holds a proof or a refutation. Stable A turns a double negation
-- into a proof; decStable gives it by either. isPropNot: two maps into
-- Empty are equal by funExt, since each value of Empty is absurd.
def Not : Type 0 -> Type 0 := fun (A : Type 0) => A -> Empty
def Dec : Type 0 -> Type 0 := fun (A : Type 0) => Sum A (Not A)
def Stable : Type 0 -> Type 0 := fun (A : Type 0) => Not (Not A) -> A
def decStable : (A : Type 0) -> Dec A -> Stable A :=
  fun (A : Type 0) (d : Dec A) (nn : Not (Not A)) => either (fun (a : A) => a) (fun (na : Not A) => absurd A (nn na)) d
def isPropNot : (A : Type 0) -> isProp (Not A) :=
  fun (A : Type 0) (f g : Not A) => funExt (fun (a : A) => absurd (Path Empty (f a) (g a)) (f a))

-- Hedberg (S5b, R4 (a)): a type with decidable equality is a set, by the
-- agda/cubical Stable route. hedbergStable: each path type from a is
-- stable, by decStable. hedbergMap: the stable map on Path A a x.
-- hedbergConst: the map is constant, since isPropNot equates the two
-- double negations. hedbergSquare: the map over a path p, a PathP from the
-- map at refl to the map at p. hedberg: one hcomp with four faces, each a
-- at k = i0; the lid is the square with the sides p, q and the ends a, b.
-- isSetNat is the instance in this file; isSetFin is in domain/fixtures.lang.
def hedbergStable : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> Stable (Path A a x) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) => decStable (Path A a x) (dec a x)
def hedbergMap : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> Path A a x -> Path A a x :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) (p : Path A a x) => hedbergStable A dec a x (fun (h : Not (Path A a x)) => h p)
def hedbergConst : (A : Type 0) -> (dec : (a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (x : A) -> (p : Path A a x) -> (q : Path A a x) -> Path (Path A a x) (hedbergMap A dec a x p) (hedbergMap A dec a x q) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (x : A) (p : Path A a x) (q : Path A a x) => fun (k : I) => hedbergStable A dec a x (isPropNot (Not (Path A a x)) (fun (h : Not (Path A a x)) => h p) (fun (h : Not (Path A a x)) => h q) @ k)
def hedbergSquare : (A : Type 0) -> (dec : (a : A) -> (b : A) -> Dec (Path A a b)) -> (a : A) -> (b : A) -> (p : Path A a b) -> PathP (fun (j : I) => Path A a (p @ j)) (hedbergMap A dec a a (fun (_ : I) => a)) (hedbergMap A dec a b p) :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (b : A) (p : Path A a b) => fun (j : I) => hedbergMap A dec a (p @ j) (fun (i : I) => p @ (i /\ j))
def hedberg : (A : Type 0) -> ((a : A) -> (b : A) -> Dec (Path A a b)) -> isSet A :=
  fun (A : Type 0) (dec : (a : A) -> (b : A) -> Dec (Path A a b)) (a : A) (b : A) (p : Path A a b) (q : Path A a b) => fun (j : I) => fun (i : I) =>
    hcomp A (~i \/ i \/ ~j \/ j) (fun (k : I) => [
      ~i -> hedbergMap A dec a a (fun (_ : I) => a) @ k,
      i -> hedbergConst A dec a b p q @ j @ k,
      ~j -> hedbergSquare A dec a b p @ i @ k,
      j -> hedbergSquare A dec a b q @ i @ k ]) a
def isSetNat : isSet Nat := hedberg Nat decEqNat
-- Cell library (S2, rulings K5 and K6). Each cell is a free monad on its
-- carrier X (the last parameter). pure is implicit. A name gets a C when
-- a kernel builtin has the plan name. The builtins keep their names.
-- Each pair toB and ofB maps a cell to its builtin B and back.
-- cellToNat and cellOfNat are the pair for NatC, because the example
-- dec.lang has a def toNat.
-- Only FinC has a path to its builtin (finPath, by ua and isoToEquiv).
-- The kernel does not give the other 4 paths (OptionC V = Option V,
-- Either E V = Sum E V, ListC A Unit = List A, NatC Unit = Nat):
-- F1. option, either and the Nat and List fold have a result type that
--     is not dependent, and elim takes only a domain family. Thus the
--     round trip on the builtin side has no proof.
-- F2. Unit has no eta rule. Thus the round trip on the cell side of
--     ListC A Unit and NatC Unit fails at the pure case.
-- F3. The Nat fold at succ x does not reduce when x is neutral.
-- These 4 paths are an open point for a later kernel slice.
cell Either (E : Type 0) (X : Type 0) := throw : E -> X
cell Free (A : Type 0) (B : A -> Type 0) (X : Type 0) := op : (opShape : A) -> (B opShape -> X) -> X
cell OptionC (X : Type 0) := noneC : X
cell ListC (A : Type 0) (X : Type 0) := consC : A -> X -> X
cell NatC (X : Type 0) := succC : X -> X
cell FinC (k : Nat) (X : Type 0) := pickC : Fin k -> X
def toOption : (V : Type 0) -> OptionC V -> Option V := fun (V : Type 0) (c : OptionC V) => fold none (fun (v : V) => some v) c
def ofOption : (V : Type 0) -> Option V -> OptionC V := fun (V : Type 0) (o : Option V) => option (noneC V) (fun (v : V) => pure v) o
def retOption : (V : Type 0) -> (c : OptionC V) -> Path (OptionC V) (ofOption V (toOption V c)) c :=
  fun (V : Type 0) (c : OptionC V) => elim (fun (d : OptionC V) => Path (OptionC V) (ofOption V (toOption V d)) d) refl (fun (v : V) => refl) c
def toSum : (E : Type 0) -> (V : Type 0) -> Either E V -> Sum E V := fun (E : Type 0) (V : Type 0) (c : Either E V) => fold (fun (e : E) => inl e) (fun (v : V) => inr v) c
def ofSum : (E : Type 0) -> (V : Type 0) -> Sum E V -> Either E V := fun (E : Type 0) (V : Type 0) (s : Sum E V) => either (fun (e : E) => throw E V e) (fun (v : V) => pure v) s
def retSum : (E : Type 0) -> (V : Type 0) -> (c : Either E V) -> Path (Either E V) (ofSum E V (toSum E V c)) c :=
  fun (E : Type 0) (V : Type 0) (c : Either E V) => elim (fun (d : Either E V) => Path (Either E V) (ofSum E V (toSum E V d)) d) (fun (e : E) => refl) (fun (v : V) => refl) c
def toList : (A : Type 0) -> ListC A Unit -> List A := fun (A : Type 0) (c : ListC A Unit) => fold (fun (a : A) (r : List A) => cons a r) (fun (u : Unit) => nil) c
def ofList : (A : Type 0) -> List A -> ListC A Unit := fun (A : Type 0) (l : List A) => fold (fun (a : A) (r : ListC A Unit) => consC A Unit a r) (pure unit) l
def cellToNat : NatC Unit -> Nat := fun (c : NatC Unit) => fold (fun (r : Nat) => succ r) (fun (u : Unit) => 0) c
def cellOfNat : Nat -> NatC Unit := fun (n : Nat) => fold (fun (r : NatC Unit) => succC Unit r) (pure unit) n
def toFin : (k : Nat) -> FinC k Empty -> Fin k :=
  fun (k : Nat) (c : FinC k Empty) => fold (fun (r : Fin k) => r) (fun (v : Empty) => absurd (Fin k) v) c
def ofFin : (k : Nat) -> Fin k -> FinC k Empty := fun (k : Nat) (r : Fin k) => pickC k Empty r
def finSec : (k : Nat) -> (r : Fin k) -> Path (Fin k) (toFin k (ofFin k r)) r := fun (k : Nat) (r : Fin k) => refl
def finRet : (k : Nat) -> (c : FinC k Empty) -> Path (FinC k Empty) (ofFin k (toFin k c)) c :=
  fun (k : Nat) (c : FinC k Empty) => elim (fun (d : FinC k Empty) => Path (FinC k Empty) (ofFin k (toFin k d)) d)
    (fun (r : Fin k) => refl) (fun (v : Empty) => absurd (Path (FinC k Empty) (ofFin k (toFin k (pure v))) (pure v)) v) c
def finPath : (k : Nat) -> Path (Type 0) (FinC k Empty) (Fin k) :=
  fun (k : Nat) => ua (FinC k Empty) (Fin k) (isoToEquiv (FinC k Empty) (Fin k) (toFin k) (ofFin k) (finSec k) (finRet k))
-- The S3 cells with laws (K3, K5). A 1-cell is a path constructor of the
-- cell and a 2-cell is a square. Each square has the squash0 form, so the
-- fold case of a square has the type isSet RES. A field name is a core
-- name (rule R4), so each name has a cell prefix.
-- Trunc1C X is the propositional truncation as a cell and Trunc0C X is
-- the set truncation. QuotC A R X has the relation on the parameter A,
-- because a cell monad is a functor in X: QuotC A R Empty is the set
-- quotient of A by R. StateC S X has the 4 laws GP, GG, PP and PG of
-- Plotkin and Power (2002) and a square. GG uses Prod S S, because a
-- curried continuation is not strictly positive (CELL_POSITIVE).
cell Trunc1C (X : Type 0) := squash1C : (sq1CFrom : X) -> (sq1CTo : X) -> (i : I) -> X [ ~i -> sq1CFrom, i -> sq1CTo ]
cell Trunc0C (X : Type 0) := squash0C : (sq0CFrom : X) -> (sq0CTo : X) -> (sq0CLeft : Path X sq0CFrom sq0CTo) -> (sq0CRight : Path X sq0CFrom sq0CTo) -> (i : I) -> (j : I) -> X
  [ ~i -> sq0CLeft @ j, i -> sq0CRight @ j, ~j -> sq0CFrom, j -> sq0CTo ]
cell QuotC (A : Type 0) (R : A -> A -> Type 0) (X : Type 0) := qinC : (qinCOf : A) -> X
  | quotEqC : (qCA : A) -> (qCB : A) -> (qCR : R qCA qCB) -> (i : I) -> X [ ~i -> qinC A R X qCA, i -> qinC A R X qCB ]
  | quotSquashC : (qsCFrom : X) -> (qsCTo : X) -> (qsCLeft : Path X qsCFrom qsCTo) -> (qsCRight : Path X qsCFrom qsCTo) -> (i : I) -> (j : I) -> X
    [ ~i -> qsCLeft @ j, i -> qsCRight @ j, ~j -> qsCFrom, j -> qsCTo ]
cell StateC (S : Type 0) (X : Type 0) := getC : (getCK : S -> X) -> X
  | putC : (putCS : S) -> (putCT : X) -> X
  | gpC : (gpCT : X) -> (i : I) -> X [ ~i -> getC S X (fun (s : S) => putC S X s gpCT), i -> gpCT ]
  | ggC : (ggCK : Prod S S -> X) -> (i : I) -> X [ ~i -> getC S X (fun (s : S) => getC S X (fun (u : S) => ggCK (pair s u))), i -> getC S X (fun (s : S) => ggCK (pair s s)) ]
  | ppC : (ppCA : S) -> (ppCB : S) -> (ppCT : X) -> (i : I) -> X [ ~i -> putC S X ppCA (putC S X ppCB ppCT), i -> putC S X ppCB ppCT ]
  | pgC : (pgCA : S) -> (pgCK : S -> X) -> (i : I) -> X [ ~i -> putC S X pgCA (getC S X pgCK), i -> putC S X pgCA (pgCK pgCA) ]
  | stSquashC : (stCFrom : X) -> (stCTo : X) -> (stCLeft : Path X stCFrom stCTo) -> (stCRight : Path X stCFrom stCTo) -> (i : I) -> (j : I) -> X
    [ ~i -> stCLeft @ j, i -> stCRight @ j, ~j -> stCFrom, j -> stCTo ]

-- Cocells (S4, K1 to K4): the dual of a cell. `cocell C ps (X : Type 0)
-- := o : X -> T` declares the cofamily C ps X, the cofree comonad on the
-- observation T at X. Each op is a field of the layer. The builtins
-- extract, extend, duplicate and map give the comonad. Store is not a
-- cocell (its lens laws are coequations, C14): it is the cofamily of the
-- layer StoreF above, and examples/cocell.lang gives its comonad by hand.
cocell EnvK (E : Type 0) (X : Type 0) := askK : X -> E
cocell StreamK (X : Type 0) := nextK : X -> X
cocell CofreeK (A : Type 0) (B : A -> Type 0) (X : Type 0) := obsK : X -> (shK : A) * (B shK -> X)

-- The base span (S5, rulings K1 to K5 and K7): the carriers of PLAN
-- section 4, the 4 classes as reference cells, the enumerations, the
-- world W and the runner run. Evaluation is strict. Thus a branch that
-- calls a continuation or can refuse is a function of Unit, and the case
-- applies it to unit.
def Role : Type 0 := Text
def Value : Type 0 := Text
def explorer : Role := "explorer"
def merchant : Role := "merchant"
def Credits : Type 0 := Nat
def creditsAdd : Credits -> Credits -> Credits := fun (a : Credits) (b : Credits) => creditsCheck (natAdd a b)
def creditsMul : Credits -> Credits -> Credits := fun (a : Credits) (b : Credits) => creditsCheck (natMul a b)
def creditsLe : Credits -> Credits -> Fin 2 := fun (a : Credits) (b : Credits) => natLe a b
def creditsSub : Credits -> Credits -> Option Credits :=
  fun (a : Credits) (b : Credits) => finCase 2 (natLe b a) none (some (natSub a b))
-- The classes (K2). A reference holds the id of an instance in the world.
cell AvatarC (X : Type 0) := avatarRef : Nat -> X
cell VirtuCardC (X : Type 0) := cardRef : Nat -> X
cell VirtualTerminalC (X : Type 0) := terminalRef : Nat -> X
cell VirtualItemC (X : Type 0) := itemRef : Nat -> X
def Avatar : Type 0 := AvatarC Empty
def VirtuCard : Type 0 := VirtuCardC Empty
def VirtualTerminal : Type 0 := VirtualTerminalC Empty
def VirtualItem : Type 0 := VirtualItemC Empty
def avatarId : Avatar -> Nat := fun (a : Avatar) => fold (fun (n : Nat) => n) (fun (v : Empty) => absurd Nat v) a
def cardId : VirtuCard -> Nat := fun (c : VirtuCard) => fold (fun (n : Nat) => n) (fun (v : Empty) => absurd Nat v) c
def terminalId : VirtualTerminal -> Nat := fun (t : VirtualTerminal) => fold (fun (n : Nat) => n) (fun (v : Empty) => absurd Nat v) t
def itemId : VirtualItem -> Nat := fun (t : VirtualItem) => fold (fun (n : Nat) => n) (fun (v : Empty) => absurd Nat v) t
-- The enumerations (K7), each with a path to Fin k in the form of finPath.
-- The entry kinds debit, credit and purchase are also names of Virt
-- 0-cells. Thus their 0-cells are debited, credited and purchased, and
-- json.c gives the PLAN names.
cell SecurityLevelC (X : Type 0) := low : X | medium : X | high : X | maximum : X
cell RarityC (X : Type 0) := common : X | uncommon : X | rare : X | epic : X | legendary : X
cell EntryKindC (X : Type 0) := create : X | bonus : X | debited : X | credited : X | transferOut : X | transferIn : X | purchased : X
def SecurityLevel : Type 0 := SecurityLevelC Empty
def Rarity : Type 0 := RarityC Empty
def EntryKind : Type 0 := EntryKindC Empty
def securityToFin : SecurityLevel -> Fin 4 := fun (c : SecurityLevel) => fold 0 1 2 3 (fun (v : Empty) => absurd (Fin 4) v) c
def securityOfFin : Fin 4 -> SecurityLevel := fun (r : Fin 4) => finCase 4 r (low Empty) (medium Empty) (high Empty) (maximum Empty)
def securitySec : (r : Fin 4) -> Path (Fin 4) (securityToFin (securityOfFin r)) r := fun (r : Fin 4) => refl
def securityRet : (c : SecurityLevel) -> Path SecurityLevel (securityOfFin (securityToFin c)) c :=
  fun (c : SecurityLevel) => elim (fun (d : SecurityLevel) => Path SecurityLevel (securityOfFin (securityToFin d)) d) refl refl refl refl
    (fun (v : Empty) => absurd (Path SecurityLevel (securityOfFin (securityToFin (pure v))) (pure v)) v) c
def securityPath : Path (Type 0) SecurityLevel (Fin 4) :=
  ua SecurityLevel (Fin 4) (isoToEquiv SecurityLevel (Fin 4) securityToFin securityOfFin securitySec securityRet)
def rarityToFin : Rarity -> Fin 5 := fun (c : Rarity) => fold 0 1 2 3 4 (fun (v : Empty) => absurd (Fin 5) v) c
def rarityOfFin : Fin 5 -> Rarity := fun (r : Fin 5) => finCase 5 r (common Empty) (uncommon Empty) (rare Empty) (epic Empty) (legendary Empty)
def raritySec : (r : Fin 5) -> Path (Fin 5) (rarityToFin (rarityOfFin r)) r := fun (r : Fin 5) => refl
def rarityRet : (c : Rarity) -> Path Rarity (rarityOfFin (rarityToFin c)) c :=
  fun (c : Rarity) => elim (fun (d : Rarity) => Path Rarity (rarityOfFin (rarityToFin d)) d) refl refl refl refl refl
    (fun (v : Empty) => absurd (Path Rarity (rarityOfFin (rarityToFin (pure v))) (pure v)) v) c
def rarityPath : Path (Type 0) Rarity (Fin 5) :=
  ua Rarity (Fin 5) (isoToEquiv Rarity (Fin 5) rarityToFin rarityOfFin raritySec rarityRet)
def kindToFin : EntryKind -> Fin 7 := fun (c : EntryKind) => fold 0 1 2 3 4 5 6 (fun (v : Empty) => absurd (Fin 7) v) c
def kindOfFin : Fin 7 -> EntryKind := fun (r : Fin 7) =>
  finCase 7 r (create Empty) (bonus Empty) (debited Empty) (credited Empty) (transferOut Empty) (transferIn Empty) (purchased Empty)
def kindSec : (r : Fin 7) -> Path (Fin 7) (kindToFin (kindOfFin r)) r := fun (r : Fin 7) => refl
def kindRet : (c : EntryKind) -> Path EntryKind (kindOfFin (kindToFin c)) c :=
  fun (c : EntryKind) => elim (fun (d : EntryKind) => Path EntryKind (kindOfFin (kindToFin d)) d) refl refl refl refl refl refl refl
    (fun (v : Empty) => absurd (Path EntryKind (kindOfFin (kindToFin (pure v))) (pure v)) v) c
def kindPath : Path (Type 0) EntryKind (Fin 7) :=
  ua EntryKind (Fin 7) (isoToEquiv EntryKind (Fin 7) kindToFin kindOfFin kindSec kindRet)
def multiplier : Rarity -> Credits := fun (r : Rarity) => fold 1 2 4 8 16 (fun (v : Empty) => absurd Credits v) r
-- The records and the world (K4). An Instance holds the state record of
-- PLAN section 4. W is in run order, and the id of an instance is its
-- position in W.
def Attributes : Type 0 := List (Prod Text Value)
def Entry : Type 0 := Prod EntryKind (Prod Credits Credits)
def Listing : Type 0 := Prod Text (Prod Credits (Prod Text (Option VirtualItem)))
cell InstanceC (X : Type 0) := avatarI : Text -> Role -> Option VirtuCard -> Attributes -> List VirtualItem -> X
  | cardI : Avatar -> Credits -> SecurityLevel -> List Entry -> X
  | terminalI : Text -> Text -> List Listing -> X
  | itemI : Text -> Text -> Credits -> Rarity -> Attributes -> X
def Instance : Type 0 := InstanceC Empty
def W : Type 0 := List Instance
def listSnoc : (A : Type 0) -> List A -> A -> List A :=
  fun (A : Type 0) (l : List A) (a : A) => fold (fun (b : A) (r : List A) => cons b r) (cons a nil) l
def listSize : (A : Type 0) -> List A -> Nat := fun (A : Type 0) (l : List A) => fold (fun (b : A) (r : Nat) => succ r) 0 l
def listAt : (A : Type 0) -> List A -> Nat -> Option A := fun (A : Type 0) (l : List A) (n : Nat) =>
  (fun (g : Nat -> Option A) => g 0) (fold (fun (b : A) (r : Nat -> Option A) => fun (j : Nat) => finCase 2 (natEq j n) (r (succ j)) (some b)) (fun (j : Nat) => none) l)
def listSet : (A : Type 0) -> List A -> Nat -> A -> List A := fun (A : Type 0) (l : List A) (n : Nat) (a : A) =>
  (fun (g : Nat -> List A) => g 0) (fold (fun (b : A) (r : Nat -> List A) => fun (j : Nat) => cons (finCase 2 (natEq j n) b a) (r (succ j))) (fun (j : Nat) => nil) l)
def listDrop : (A : Type 0) -> List A -> Nat -> List A := fun (A : Type 0) (l : List A) (n : Nat) =>
  (fun (g : Nat -> List A) => g 0) (fold (fun (b : A) (r : Nat -> List A) => fun (j : Nat) => (fun (s : List A) => finCase 2 (natEq j n) (cons b s) s) (r (succ j)))
    (fun (j : Nat) => nil) l)
-- attrSet keeps a key at the place of its first set (open point 8).
def attrGet : Attributes -> Text -> Option Value := fun (l : Attributes) (k : Text) =>
  fold (fun (p : Prod Text Value) (r : Option Value) => option r (fun (u : Unit) => some (second p)) (textEq (first p) k)) none l
def attrSet : Attributes -> Text -> Value -> Attributes := fun (l : Attributes) (k : Text) (v : Value) =>
  option (listSnoc (Prod Text Value) l (pair k v))
    (fun (x : Value) => fold (fun (p : Prod Text Value) (r : Attributes) => cons (option p (fun (u : Unit) => pair k v) (textEq (first p) k)) r) nil l)
    (attrGet l k)
-- An id with no instance, or an instance of the wrong class, is the
-- run-time refusal EVAL_REF_UNKNOWN (K2).
def instanceAt : W -> Nat -> Instance := fun (w : W) (n : Nat) =>
  option (fun (u : Unit) => refUnknown Instance n) (fun (a : Instance) (u : Unit) => a) (listAt Instance w n) unit
def withAvatar : (R : Type 0) -> W -> Avatar -> (Text -> Role -> Option VirtuCard -> Attributes -> List VirtualItem -> R) -> R :=
  fun (R : Type 0) (w : W) (a : Avatar) (f : Text -> Role -> Option VirtuCard -> Attributes -> List VirtualItem -> R) => fold f
    (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => refUnknown R (avatarId a))
    (fun (n : Text) (c : Text) (s : List Listing) => refUnknown R (avatarId a))
    (fun (n : Text) (k : Text) (b : Credits) (r : Rarity) (s : Attributes) => refUnknown R (avatarId a))
    (fun (v : Empty) => absurd R v) (instanceAt w (avatarId a))
def withCard : (R : Type 0) -> W -> VirtuCard -> (Avatar -> Credits -> SecurityLevel -> List Entry -> R) -> R :=
  fun (R : Type 0) (w : W) (c : VirtuCard) (f : Avatar -> Credits -> SecurityLevel -> List Entry -> R) => fold
    (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => refUnknown R (cardId c)) f
    (fun (n : Text) (k : Text) (s : List Listing) => refUnknown R (cardId c))
    (fun (n : Text) (k : Text) (b : Credits) (r : Rarity) (s : Attributes) => refUnknown R (cardId c))
    (fun (v : Empty) => absurd R v) (instanceAt w (cardId c))
def withTerminal : (R : Type 0) -> W -> VirtualTerminal -> (Text -> Text -> List Listing -> R) -> R :=
  fun (R : Type 0) (w : W) (t : VirtualTerminal) (f : Text -> Text -> List Listing -> R) => fold
    (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => refUnknown R (terminalId t))
    (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => refUnknown R (terminalId t)) f
    (fun (n : Text) (k : Text) (b : Credits) (r : Rarity) (s : Attributes) => refUnknown R (terminalId t))
    (fun (v : Empty) => absurd R v) (instanceAt w (terminalId t))
def withItem : (R : Type 0) -> W -> VirtualItem -> (Text -> Text -> Credits -> Rarity -> Attributes -> R) -> R :=
  fun (R : Type 0) (w : W) (t : VirtualItem) (f : Text -> Text -> Credits -> Rarity -> Attributes -> R) => fold
    (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => refUnknown R (itemId t))
    (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => refUnknown R (itemId t))
    (fun (n : Text) (k : Text) (s : List Listing) => refUnknown R (itemId t)) f
    (fun (v : Empty) => absurd R v) (instanceAt w (itemId t))
def avatarPut : W -> Avatar -> (Text -> Role -> Option VirtuCard -> Attributes -> List VirtualItem -> Instance) -> W :=
  fun (w : W) (a : Avatar) (f : Text -> Role -> Option VirtuCard -> Attributes -> List VirtualItem -> Instance) =>
    listSet Instance w (avatarId a) (withAvatar Instance w a f)
def terminalPut : W -> VirtualTerminal -> (Text -> Text -> List Listing -> Instance) -> W :=
  fun (w : W) (t : VirtualTerminal) (f : Text -> Text -> List Listing -> Instance) => listSet Instance w (terminalId t) (withTerminal Instance w t f)
def itemPut : W -> VirtualItem -> (Text -> Text -> Credits -> Rarity -> Attributes -> Instance) -> W :=
  fun (w : W) (t : VirtualItem) (f : Text -> Text -> Credits -> Rarity -> Attributes -> Instance) => listSet Instance w (itemId t) (withItem Instance w t f)
def avatarCheck : W -> Avatar -> Avatar := fun (w : W) (a : Avatar) =>
  withAvatar Avatar w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => a)
def cardCheck : W -> VirtuCard -> VirtuCard := fun (w : W) (c : VirtuCard) =>
  withCard VirtuCard w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => c)
-- A card change adds one entry with the amount and the balance after it.
def cardAdd : W -> VirtuCard -> Credits -> EntryKind -> W := fun (w : W) (c : VirtuCard) (m : Credits) (e : EntryKind) =>
  withCard W w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) =>
    listSet Instance w (cardId c) (cardI Empty o (creditsAdd b m) l (listSnoc Entry h (pair e (pair m (creditsAdd b m))))))
def cardSub : W -> VirtuCard -> Credits -> EntryKind -> Option W := fun (w : W) (c : VirtuCard) (m : Credits) (e : EntryKind) =>
  withCard (Option W) w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) =>
    option none (fun (d : Credits) => some (listSet Instance w (cardId c) (cardI Empty o d l (listSnoc Entry h (pair e (pair m d)))))) (creditsSub b m))
def cardTransfer : W -> VirtuCard -> VirtuCard -> Credits -> Option W := fun (w : W) (a : VirtuCard) (b : VirtuCard) (m : Credits) =>
  (fun (a : VirtuCard) (b : VirtuCard) => (fun (h : Unit -> Option W) => h unit) (finCase 2 (natEq (cardId a) (cardId b))
    (fun (u : Unit) => option none (fun (v : W) => some (cardAdd v b m (transferIn Empty))) (cardSub w a m (transferOut Empty)))
    (fun (u : Unit) => none))) (cardCheck w a) (cardCheck w b)
-- A purchase (PLAN 5.1 row 21): the first listing with the name.
def listingFind : List Listing -> Text -> Option (Prod Nat Listing) := fun (s : List Listing) (n : Text) =>
  (fun (g : Nat -> Option (Prod Nat Listing)) => g 0) (fold (fun (p : Listing) (r : Nat -> Option (Prod Nat Listing)) => fun (j : Nat) => option (r (succ j)) (fun (u : Unit) => some (pair j p)) (textEq (first p) n))
    (fun (j : Nat) => none) s)
def purchaseIn : W -> VirtualTerminal -> Avatar -> Text -> VirtuCard -> Option (Prod W VirtualItem) :=
  fun (w : W) (t : VirtualTerminal) (u : Avatar) (n : Text) (c : VirtuCard) =>
    (fun (u : Avatar) (c : VirtuCard) => withTerminal (Option (Prod W VirtualItem)) w t
    (fun (tn : Text) (tc : Text) (s : List Listing) => option none
      (fun (f : Prod Nat Listing) => option none
        (fun (w1 : W) => (fun (g : Prod W VirtualItem) => some (pair
            (avatarPut (terminalPut (first g) t (fun (a : Text) (b : Text) (x : List Listing) => terminalI Empty a b (listDrop Listing x (first f))))
              u (fun (a : Text) (r : Role) (o : Option VirtuCard) (xs : Attributes) (v : List VirtualItem) => avatarI Empty a r o xs (listSnoc VirtualItem v (second g))))
            (second g)))
          (option (pair (listSnoc Instance w1 (itemI Empty (first (second f)) tc (first (second (second f))) (common Empty) nil)) (itemRef Empty (listSize Instance w1)))
            (fun (x : VirtualItem) => pair w1 x) (second (second (second (second f))))))
        (cardSub w c (first (second (second f))) (purchased Empty)))
      (listingFind s n))) (avatarCheck w u) (cardCheck w c)
-- Virt (K3): one 0-cell for each operation of PLAN 5.1, in row order. An
-- op with the result R has a field R -> X; an op with the result Unit has
-- a field X.
cell Virt (X : Type 0) := avatar : Text -> Role -> (Avatar -> X) -> X
  | avatarName : Avatar -> (Text -> X) -> X
  | avatarRole : Avatar -> (Role -> X) -> X
  | avatarCard : Avatar -> (Option VirtuCard -> X) -> X
  | attachCard : Avatar -> VirtuCard -> X -> X
  | avatarSet : Avatar -> Text -> Value -> X -> X
  | avatarGet : Avatar -> Text -> (Option Value -> X) -> X
  | avatarInventory : Avatar -> (List VirtualItem -> X) -> X
  | createVirtucard : Avatar -> Credits -> (VirtuCard -> X) -> X
  | cardBalance : VirtuCard -> (Credits -> X) -> X
  | cardSecurity : VirtuCard -> (SecurityLevel -> X) -> X
  | tapDenominator : VirtuCard -> Credits -> X -> X
  | debit : VirtuCard -> Credits -> (Option Unit -> X) -> X
  | credit : VirtuCard -> Credits -> X -> X
  | setSecurity : VirtuCard -> SecurityLevel -> X -> X
  | cardHistory : VirtuCard -> (List Entry -> X) -> X
  | transfer : VirtuCard -> VirtuCard -> Credits -> (Option Unit -> X) -> X
  | terminal : Text -> Text -> (VirtualTerminal -> X) -> X
  | listItem : VirtualTerminal -> Text -> Credits -> Text -> X -> X
  | listVirtualItem : VirtualTerminal -> VirtualItem -> X -> X
  | terminalInventory : VirtualTerminal -> (List Listing -> X) -> X
  | purchaseItem : VirtualTerminal -> Avatar -> Text -> VirtuCard -> (Option VirtualItem -> X) -> X
  | purchase : VirtualTerminal -> Text -> VirtuCard -> (Option VirtualItem -> X) -> X
  | item : Text -> Text -> Credits -> (VirtualItem -> X) -> X
  | setRarity : VirtualItem -> Rarity -> X -> X
  | itemValue : VirtualItem -> (Credits -> X) -> X
  | itemSet : VirtualItem -> Text -> Value -> X -> X
  | itemGet : VirtualItem -> Text -> (Option Value -> X) -> X
-- run (K5): the fold of a program into a function of the world. A new
-- instance goes at the end of W. The 1-cell cases come in S6.
def run : (X : Type 0) -> Virt X -> W -> Prod W X :=
  fun (X : Type 0) (t : Virt X) => fold
    (fun (n : Text) (r : Role) (k : Avatar -> W -> Prod W X) => fun (w : W) =>
      k (avatarRef Empty (listSize Instance w)) (listSnoc Instance w (avatarI Empty n r none nil nil)))
    (fun (a : Avatar) (k : Text -> W -> Prod W X) => fun (w : W) =>
      k (withAvatar Text w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => n)) w)
    (fun (a : Avatar) (k : Role -> W -> Prod W X) => fun (w : W) =>
      k (withAvatar Role w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => r)) w)
    (fun (a : Avatar) (k : Option VirtuCard -> W -> Prod W X) => fun (w : W) =>
      k (withAvatar (Option VirtuCard) w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => o)) w)
    (fun (a : Avatar) (c : VirtuCard) (k : W -> Prod W X) => fun (w : W) =>
      k (avatarPut w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => avatarI Empty n r (some (cardCheck w c)) s v)))
    (fun (a : Avatar) (y : Text) (z : Value) (k : W -> Prod W X) => fun (w : W) =>
      k (avatarPut w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => avatarI Empty n r o (attrSet s y z) v)))
    (fun (a : Avatar) (y : Text) (k : Option Value -> W -> Prod W X) => fun (w : W) =>
      k (withAvatar (Option Value) w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => attrGet s y)) w)
    (fun (a : Avatar) (k : List VirtualItem -> W -> Prod W X) => fun (w : W) =>
      k (withAvatar (List VirtualItem) w a (fun (n : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) => v)) w)
    (fun (a : Avatar) (m : Credits) (k : VirtuCard -> W -> Prod W X) => fun (w : W) =>
      k (cardRef Empty (listSize Instance w))
        (listSnoc Instance w (cardI Empty (avatarCheck w a) (creditsCheck m) (low Empty) (cons (pair (create Empty) (pair m (creditsCheck m))) nil))))
    (fun (c : VirtuCard) (k : Credits -> W -> Prod W X) => fun (w : W) =>
      k (withCard Credits w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => b)) w)
    (fun (c : VirtuCard) (k : SecurityLevel -> W -> Prod W X) => fun (w : W) =>
      k (withCard SecurityLevel w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => l)) w)
    (fun (c : VirtuCard) (m : Credits) (k : W -> Prod W X) => fun (w : W) => k (cardAdd w c m (bonus Empty)))
    (fun (c : VirtuCard) (m : Credits) (k : Option Unit -> W -> Prod W X) => fun (w : W) =>
      option (fun (u : Unit) => k none w) (fun (v : W) (u : Unit) => k (some unit) v) (cardSub w c m (debited Empty)) unit)
    (fun (c : VirtuCard) (m : Credits) (k : W -> Prod W X) => fun (w : W) => k (cardAdd w c m (credited Empty)))
    (fun (c : VirtuCard) (e : SecurityLevel) (k : W -> Prod W X) => fun (w : W) =>
      k (withCard W w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => listSet Instance w (cardId c) (cardI Empty o b e h))))
    (fun (c : VirtuCard) (k : List Entry -> W -> Prod W X) => fun (w : W) =>
      k (withCard (List Entry) w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => h)) w)
    (fun (c : VirtuCard) (d : VirtuCard) (m : Credits) (k : Option Unit -> W -> Prod W X) => fun (w : W) =>
      option (fun (u : Unit) => k none w) (fun (v : W) (u : Unit) => k (some unit) v) (cardTransfer w c d m) unit)
    (fun (n : Text) (y : Text) (k : VirtualTerminal -> W -> Prod W X) => fun (w : W) =>
      k (terminalRef Empty (listSize Instance w)) (listSnoc Instance w (terminalI Empty n y nil)))
    (fun (t : VirtualTerminal) (n : Text) (p : Credits) (y : Text) (k : W -> Prod W X) => fun (w : W) =>
      k (terminalPut w t (fun (a : Text) (b : Text) (x : List Listing) => terminalI Empty a b (listSnoc Listing x (pair n (pair (creditsCheck p) (pair y none)))))))
    (fun (t : VirtualTerminal) (z : VirtualItem) (k : W -> Prod W X) => fun (w : W) =>
      k (terminalPut w t (fun (a : Text) (b : Text) (x : List Listing) => terminalI Empty a b (listSnoc Listing x
        (withItem Listing w z (fun (n : Text) (y : Text) (v : Credits) (r : Rarity) (s : Attributes) => pair n (pair (creditsMul v (multiplier r)) (pair "" (some z)))))))))
    (fun (t : VirtualTerminal) (k : List Listing -> W -> Prod W X) => fun (w : W) =>
      k (withTerminal (List Listing) w t (fun (a : Text) (b : Text) (x : List Listing) => x)) w)
    (fun (t : VirtualTerminal) (a : Avatar) (n : Text) (c : VirtuCard) (k : Option VirtualItem -> W -> Prod W X) => fun (w : W) =>
      option (fun (u : Unit) => k none w) (fun (g : Prod W VirtualItem) (u : Unit) => k (some (second g)) (first g)) (purchaseIn w t a n c) unit)
    (fun (t : VirtualTerminal) (n : Text) (c : VirtuCard) (k : Option VirtualItem -> W -> Prod W X) => fun (w : W) =>
      option (fun (u : Unit) => k none w) (fun (g : Prod W VirtualItem) (u : Unit) => k (some (second g)) (first g))
        (purchaseIn w t (withCard Avatar w c (fun (o : Avatar) (b : Credits) (l : SecurityLevel) (h : List Entry) => o)) n c) unit)
    (fun (n : Text) (y : Text) (v : Credits) (k : VirtualItem -> W -> Prod W X) => fun (w : W) =>
      k (itemRef Empty (listSize Instance w)) (listSnoc Instance w (itemI Empty n y (creditsCheck v) (common Empty) nil)))
    (fun (z : VirtualItem) (e : Rarity) (k : W -> Prod W X) => fun (w : W) =>
      k (itemPut w z (fun (n : Text) (y : Text) (v : Credits) (r : Rarity) (s : Attributes) => itemI Empty n y v e s)))
    (fun (z : VirtualItem) (k : Credits -> W -> Prod W X) => fun (w : W) =>
      k (withItem Credits w z (fun (n : Text) (y : Text) (v : Credits) (r : Rarity) (s : Attributes) => creditsMul v (multiplier r))) w)
    (fun (z : VirtualItem) (y : Text) (e : Value) (k : W -> Prod W X) => fun (w : W) =>
      k (itemPut w z (fun (n : Text) (b : Text) (v : Credits) (r : Rarity) (s : Attributes) => itemI Empty n b v r (attrSet s y e))))
    (fun (z : VirtualItem) (y : Text) (k : Option Value -> W -> Prod W X) => fun (w : W) =>
      k (withItem (Option Value) w z (fun (n : Text) (b : Text) (v : Credits) (r : Rarity) (s : Attributes) => attrGet s y)) w)
    (fun (v : X) => fun (w : W) => pair w v)
    t
