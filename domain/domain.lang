      (avatarSetR (Prod W X) (avatarId a) (fun (s : Attributes) => attrSet s y z) (kf (some z)) w 0)
      (agetUse X a y z kf w)
      (fun (i : I) => avatarFold (Prod W X) (avatarId a) (worldRead w (avatarId a) 0) (fun (m : Text) (r : Role) (o : Option VirtuCard) (s : Attributes) (v : List VirtualItem) =>
        kf (attrSetGet y z s @ i) (worldSetF w (avatarId a) (avatarI Empty m r o (attrSet s y z) v) 0)))
