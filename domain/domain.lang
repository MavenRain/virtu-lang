-- The attribute laws of attrSetF: a get after a set (attrSetGet) and a set
-- after a set (attrSetSet).
def attrSetGet : (k : Text) -> (v : Value) -> (l : Attributes) -> Path (Option Value) (attrGet (attrSetF l k v falseB) k) (some v) :=
  fun (k : Text) (v : Value) (l : Attributes) => elim (fun (d : AttrC Unit) => Path (Option Value) (attrGet (attrSetF d k v falseB) k) (some v))
    (fun (p : Prod Text Value) (t : AttrC Unit) (ih : Path (Option Value) (attrGet (attrSetF t k v falseB) k) (some v)) =>
      elim (fun (e : BoolC Unit) => Path (Option Value)
          (ifB (Option Value) e (some (ifB Value e v (second p))) (attrGet (attrSetF t k v (ifB BoolB e trueB falseB)) k))
          (some v))
        (fun (u : Unit) => refl)
        (fun (u : Unit) => ih)
        (textEqB (first p) k))
    (fun (u : Unit) => refl) l
def attrSetSet : (k : Text) -> (v1 : Value) -> (v2 : Value) -> (l : Attributes) -> (f : BoolB) -> Path Attributes (attrSetF (attrSetF l k v1 f) k v2 f) (attrSetF l k v2 f) :=
  fun (k : Text) (v1 : Value) (v2 : Value) (l : Attributes) => elim (fun (d : AttrC Unit) => (f : BoolB) -> Path Attributes (attrSetF (attrSetF d k v1 f) k v2 f) (attrSetF d k v2 f))
    (fun (p : Prod Text Value) (t : AttrC Unit) (ih : (f : BoolB) -> Path Attributes (attrSetF (attrSetF t k v1 f) k v2 f) (attrSetF t k v2 f)) => fun (f : BoolB) =>
      elim (fun (e : BoolC Unit) => Path Attributes
          (attrCons Unit (pair (first p) (ifB Value e v2 (ifB Value e v1 (second p)))) (attrSetF (attrSetF t k v1 (ifB BoolB e trueB f)) k v2 (ifB BoolB e trueB f)))
          (attrCons Unit (pair (first p) (ifB Value e v2 (second p))) (attrSetF t k v2 (ifB BoolB e trueB f))))
        (fun (u : Unit) => fun (i : I) => attrCons Unit (pair (first p) v2) (ih trueB @ i))
        (fun (u : Unit) => fun (i : I) => attrCons Unit (pair (first p) (second p)) (ih f @ i))
        (textEqB (first p) k))
    (fun (u : Unit) => fun (f : BoolB) => elim (fun (b : BoolC Unit) => Path Attributes (attrSetF (ifB Attributes b attrNil (attrCons Unit (pair k v1) attrNil)) k v2 b) (ifB Attributes b attrNil (attrCons Unit (pair k v2) attrNil)))
        (fun (u2 : Unit) => refl) (fun (u2 : Unit) => refl) f) l
