      (fun (w2 : W) => withAvatar (Prod W X) w2 a (fun (n2 : Text) (r2 : Role) (o2 : Option VirtuCard) (s2 : Attributes) (v2 : List VirtualItem) => kx (worldSet w2 (avatarId a) (avatarI Empty n2 r2 o2 (attrSet s2 y z2) v2))))
