  fun (X : Type 0) (a : Avatar) (y : Text) (z1 : Value) (z2 : Value) (kx : W -> Prod W X) (w : W) =>
    pathComp (Prod W X) (asetL X a y z1 z2 kx w) (avatarSetR (Prod W X) (avatarId a) (fun (s : Attributes) => attrSet (attrSet s y z1) y z2) kx w 0)
      (avatarSetR (Prod W X) (avatarId a) (fun (s : Attributes) => attrSet s y z2) kx w 0)
      (asetUse X a y z1 z2 kx w)
      (fun (i : I) => avatarSetR (Prod W X) (avatarId a) (fun (s : Attributes) => attrSetSet y z1 z2 s falseB @ i) kx w 0)
